                </ui:Label>
                <ui:VisualElement style="flex-direction: row;">
                    <ui:Label text="Label" name="title-exit__back-option" class="text text__option title-exit__option">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:1aed80fe92dd5c34a98ae3220109e6ba" entry="Id(6200630824960)" />
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="Label" name="title-exit__exit-option" class="text text__option title-exit__option">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:1aed80fe92dd5c34a98ae3220109e6ba" entry="Id(6276921020416)" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
