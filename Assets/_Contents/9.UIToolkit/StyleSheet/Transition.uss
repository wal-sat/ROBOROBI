:root {
}

.transition-panel {
    width: 100%;
    height: 100%;
    rotate: 10deg;
    scale: 1.75 1.75;
    transition-timing-function: ease-out-cubic;
    position: absolute;
    display: none;
}

.transition-panel--right {
    flex-grow: 1;
    translate: 150% 0;
}

.transition-panel--center {
    flex-grow: 1;
    translate: 0% 0;
}

.transition-panel--left {
    flex-grow: 1;
    translate: -150% 0;
}
