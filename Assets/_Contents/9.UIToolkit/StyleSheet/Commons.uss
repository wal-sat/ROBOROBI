:root {
}

.root-element {
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/_Contents/10.Others/Font/YDWaosagi.otf?fileID=12800000&guid=7badb4b17c809b247a8a532d1ac4fb5b&type=3#YDWaosagi");
}

.animatable {
    transition-duration: 0.5s, 1s;
    transition-timing-function: ease-out-cubic, ease-in-out;
    transition-property: all, rotate;
}

.animatable--animate {
    rotate: 7deg;
}

.animatable--animate-toggle {
    rotate: -7deg;
}

.text {
    color: rgb(22, 22, 22);
    font-size: 32px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.option {
    color: rgb(100, 100, 100);
    -unity-background-image-tint-color: rgb(175, 175, 175);
}

.option--select {
    color: rgb(22, 22, 22);
    scale: 1.25 1.25;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.visible {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-in-cubic;
}

.visible--disable {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
}

.panel {
    width: 100%;
    height: 100%;
    position: absolute;
    translate: 0 -100%;
    transition-duration: 1s;
    transition-timing-function: ease-out-cubic;
}

.panel--open {
    translate: 0 0%;
}
