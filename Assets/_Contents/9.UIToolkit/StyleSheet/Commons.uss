:root {
}

.RootElement {
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/_Contents/10.Others/Font/YDWaosagi.otf?fileID=12800000&guid=7badb4b17c809b247a8a532d1ac4fb5b&type=3#YDWaosagi");
}

.text__normal {
    color: rgb(22, 22, 22);
    font-size: 32px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.text__option {
    color: rgb(100, 100, 100);
    font-size: 32px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-duration: 0.5s, 1s;
    transition-timing-function: ease-out-cubic, ease-in-out;
    transition-property: all, rotate;
}

.text__option--selected {
    color: rgb(22, 22, 22);
    scale: 1.5 1.5;
    rotate: 7deg;
}

.text__option--selected-animate {
    rotate: -7deg;
}
